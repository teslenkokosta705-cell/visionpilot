<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="326dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_panel"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header bar (draggable) -->
    <LinearLayout
        android:id="@+id/panelDragHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ScreenPilot AI"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPanelVoice"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="#1E293B"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Голос: ВКЛ"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPanelMinimize"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1E293B"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="—"
            android:textColor="#F8FAFC"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Mode Switcher: Task Mode vs Free Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnModeTask"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:backgroundTint="#2563EB"
            android:text="Задача"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnModeFree"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#1E293B"
            android:text="Свободный полёт"
            android:textAllCaps="false"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Status + Mini-goal -->
    <TextView
        android:id="@+id/tvPanelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Готов к работе"
        android:textColor="#93C5FD"
        android:textSize="12sp" />

    <!-- Dialogue / Thought Stream ScrollView -->
    <ScrollView
        android:id="@+id/svPanelLog"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:layout_marginTop="8dp"
        android:background="#0B0F17"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvPanelLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Введите короткую команду или нажмите СТАРТ с пустым полем для Свободного полёта."
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
    </ScrollView>

    <!-- Task / Reply Input -->
    <EditText
        android:id="@+id/etPanelInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#0E141F"
        android:hint="Команда (или пусто = Свободный полёт)"
        android:inputType="textMultiLine"
        android:maxLines="3"
        android:minHeight="42dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="13sp" />

    <!-- Action Buttons: START / STOP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPanelStart"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#2563EB"
            android:text="СТАРТ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPanelStop"
            android:layout_width="96dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#DC2626"
            android:text="СТОП"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
